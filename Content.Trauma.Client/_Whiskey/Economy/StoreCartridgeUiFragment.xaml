<economy:StoreCartridgeUiFragment xmlns="https://spacestation14.io"
                                  xmlns:economy="clr-namespace:Content.Trauma.Client._Whiskey.Economy"
                                  Orientation="Vertical"
                                  VerticalExpand="True">
    <BoxContainer Orientation="Horizontal" Margin="4 8">
        <Label Name="SaldoLabel" Access="Public" StyleClasses="LabelHeading"/>
        <BoxContainer HorizontalExpand="True"/>
    </BoxContainer>
    <BoxContainer Orientation="Horizontal" Margin="4 0 4 8">
        <Label Name="ParaLabel" Access="Public" Text="{Loc 'store-cartridge-recipient'}" Margin="0 0 8 0"/>
        <OptionButton Name="DestinatarioBotao" Access="Public" HorizontalExpand="True"/>
    </BoxContainer>
    <ScrollContainer VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Name="ListaContainer" Access="Public" Margin="4 0"/>
    </ScrollContainer>
</economy:StoreCartridgeUiFragment>
